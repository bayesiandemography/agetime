   \code{"2000 or earlier"}, \code{"up to 2000"} \tab \verb{(-Inf,2001)} \cr
   \code{"2000+"}, \code{"2000 or more"}, \code{"2000 or later"} \tab \verb{[2000,Inf)} \cr
}


